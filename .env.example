# Firebase Realtime Database that stores RSVP responses
VITE_FIREBASE_DB_URL=https://<project-id>-default-rtdb.firebaseio.com
# Web API key (Firebase console > Project settings > General > Your apps > Web app config: apiKey)
VITE_FIREBASE_API_KEY=

# Public address of the site, used for the WhatsApp / Facebook link preview (no trailing slash)
VITE_SITE_URL=https://your-domain.com
